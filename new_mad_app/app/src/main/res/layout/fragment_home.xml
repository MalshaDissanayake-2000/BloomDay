<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp">

        <!--  HEADER SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text=" 🌻BloomDay"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/purple"/>

            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_logo"
                android:scaleType="centerCrop"
                android:contentDescription="Profile picture"
                android:clipToOutline="true"
                android:layout_marginEnd="4dp"/>
        </LinearLayout>

        <!-- Greeting & Date -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good morning👋"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="@color/green"
                android:paddingBottom="4dp"/>

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Oct 4, 2025"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Habits Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="@color/white"
            app:cardElevation="6dp"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvHabitsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Habits"
                    android:padding="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/purple"/>

                <TextView
                    android:id="@+id/tvHabitsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    android:text="0 / 0 complete"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:layout_marginTop="6dp"/>

                <ProgressBar
                    android:id="@+id/pbHabits"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:padding="5dp"
                    android:progressTint="@color/green"
                    android:progressBackgroundTint="@color/gray"
                    android:progress="40" />

                <Button
                    android:id="@+id/btnOpenHabits"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="14dp"
                    android:backgroundTint="@color/purple"
                    android:layout_marginRight="10dp"
                    android:layout_marginBottom="10dp"
                    android:text="View Habits" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hydration Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="@color/white"
            app:cardElevation="2dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHydrationTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:text="Hydration"
                    android:textColor="@color/purple"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHydrationSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:padding="5dp"
                    android:text="2 / 8 glasses"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/pbHydration"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:max="100"
                    android:progressTint="@color/blue"
                    android:progressBackgroundTint="@color/gray"
                    android:padding="5dp"
                    android:progress="25" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnAddHydrationQuick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/purple"
                        android:text="+ Drink" />

                    <Button
                        android:id="@+id/btnOpenCalendar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/purple"
                        android:layout_marginRight="10dp"
                        android:text="Open Calendar" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Completed Habits Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            android:backgroundTint="@color/white"
            app:cardElevation="6dp"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvCompletedHabitsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed Habits"
                    android:textColor="@color/purple"
                    android:layout_marginLeft="10dp"
                    android:layout_marginTop="10dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/llCompletedHabitsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shortcuts row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:weightSum="3">

            <Button
                android:id="@+id/btnShortcutHabits"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/purple"
                android:text="Habits"/>

            <View android:layout_width="12dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnShortcutCalendar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:backgroundTint="@color/purple"
                android:layout_height="wrap_content"
                android:text="Calendar"/>

            <View android:layout_width="12dp" android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnShortcutHydration"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:backgroundTint="@color/purple"
                android:layout_height="wrap_content"
                android:text="Hydration"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="32dp"/>
    </LinearLayout>
</ScrollView>
